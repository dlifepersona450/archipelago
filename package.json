{
  "name": "dlife-archipelago",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "lint": "eslint src tests scripts vite.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:browser": "node scripts/browser-check.mjs",
    "docs:check": "node scripts/check-docs.mjs",
    "commit:check": "node scripts/check-commit.mjs",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run docs:check && npm run build"
  },
  "dependencies": {
    "three": "0.180.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/three": "0.180.0",
    "eslint": "^10.13.0",
    "globals": "^16.5.0",
    "playwright": "^1.64.1",
    "prettier": "^3.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.3.7"
  }
}
